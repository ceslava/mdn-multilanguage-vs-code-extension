{
  "name": "mdn-in-your-language",
  "displayName": "MDN in Your Language",
  "description": "Read MDN Web Docs on hover in Spanish, English, French, Brazilian Portuguese, German, Italian, Japanese, Korean, Simplified Chinese, or Russian, with English fallback.",
  "version": "0.1.10",
  "publisher": "ceslava",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onCommand:mdnMultilenguaje.selectLanguage",
    "onCommand:mdnMultilenguaje.toggleNativeHover",
    "onCommand:mdnMultilenguaje.clearCache",
    "onCommand:mdnMultilenguaje.showLog"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mdnMultilenguaje.selectLanguage",
        "title": "MDN in Your Language: Elegir idioma"
      },
      {
        "command": "mdnMultilenguaje.showLog",
        "title": "MDN in Your Language: Ver diagnóstico"
      },
      {
        "command": "mdnMultilenguaje.toggleNativeHover",
        "title": "MDN in Your Language: Desactivar/restaurar documentación nativa"
      },
      {
        "command": "mdnMultilenguaje.clearCache",
        "title": "MDN in Your Language: Vaciar caché"
      }
    ],
    "configuration": {
      "title": "MDN in Your Language",
      "properties": {
        "mdnMultilenguaje.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "es",
            "en-US",
            "fr",
            "pt-BR",
            "de",
            "it",
            "ja",
            "ko",
            "zh-CN",
            "ru"
          ],
          "description": "auto: usa el idioma de VS Code; si la traducción no está disponible, utiliza inglés."
        },
        "mdnMultilenguaje.maxCharacters": {
          "type": "integer",
          "default": 500,
          "minimum": 120,
          "maximum": 2000,
          "description": "Longitud máxima del resumen contextual."
        },
        "mdnMultilenguaje.cacheDays": {
          "type": "integer",
          "default": 30,
          "enum": [
            0,
            7,
            30,
            90
          ],
          "description": "Días de validez de la caché local; 0 desactiva la caché de resultados correctos."
        }
      }
    },
    "configurationDefaults": {
      "html.hover.documentation": false,
      "html.hover.references": false,
      "css.hover.documentation": false,
      "css.hover.references": false,
      "scss.hover.documentation": false,
      "scss.hover.references": false,
      "less.hover.documentation": false,
      "less.hover.references": false
    }
  },
  "scripts": {
    "package": "npx @vscode/vsce package"
  },
  "keywords": [
    "mdn",
    "html",
    "css",
    "documentation",
    "spanish",
    "multilingual"
  ],
  "author": {
    "name": "Cristian Eslava",
    "url": "https://ceslava.com"
  },
  "homepage": "https://ceslava.com",
  "icon": "icon.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#14213D",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ceslava/mdn-multilanguage-vs-code-extension.git"
  },
  "bugs": {
    "url": "https://github.com/ceslava/mdn-multilanguage-vs-code-extension/issues"
  },
  "dependencies": {
    "@mdn/browser-compat-data": "7.3.17",
    "typescript": "5.9.3",
    "vscode-css-languageservice": "6.3.10",
    "vscode-html-languageservice": "5.6.2"
  }
}
